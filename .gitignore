/pico2w/host/modern/vendor/webview2/*
!/pico2w/host/modern/vendor/webview2/LICENSE.txt
!/pico2w/host/modern/vendor/webview2/NOTICE.txt
!/pico2w/host/modern/vendor/webview2/lib/
/pico2w/host/modern/vendor/webview2/lib/*
!/pico2w/host/modern/vendor/webview2/lib/net462/
/pico2w/host/modern/vendor/webview2/lib/net462/*
!/pico2w/host/modern/vendor/webview2/lib/net462/Microsoft.Web.WebView2.Core.dll
!/pico2w/host/modern/vendor/webview2/lib/net462/Microsoft.Web.WebView2.WinForms.dll
!/pico2w/host/modern/vendor/webview2/runtimes/
/pico2w/host/modern/vendor/webview2/runtimes/*
!/pico2w/host/modern/vendor/webview2/runtimes/win-x64/
/pico2w/host/modern/vendor/webview2/runtimes/win-x64/*
!/pico2w/host/modern/vendor/webview2/runtimes/win-x64/native/
/pico2w/host/modern/vendor/webview2/runtimes/win-x64/native/*
!/pico2w/host/modern/vendor/webview2/runtimes/win-x64/native/WebView2Loader.dll

